{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sec-le",
	"account_id": "6aad81ca09da398069ce05069eae969d",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"analytics_engine_datasets": [{ "binding": "STATS", "dataset": "secle_games" }],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "secle.crimsondefense.org", "custom_domain": true }]
}
