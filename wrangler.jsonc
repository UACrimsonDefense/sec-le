{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sec-le",
	"account_id": "6aad81ca09da398069ce05069eae969d",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"analytics_engine_datasets": [{ "binding": "STATS", "dataset": "secle_games" }],
	"d1_databases": [
		{
			"binding": "AUTH",
			"database_name": "secle-auth",
			"database_id": "7f900660-1cee-44d8-a511-d0bb63cfc454",
			"migrations_dir": "migrations/auth"
		},
		{
			"binding": "GAME",
			"database_name": "secle-game",
			"database_id": "c89dd52f-189f-471e-ba61-8b773131af26",
			"migrations_dir": "migrations/game"
		}
	],
	"vpc_services": [{ "binding": "HASHER", "service_id": "01a166fa-2378-72b1-88c7-27d06129b8a1" }],
	"ratelimits": [
		{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "REGISTER_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
		{ "name": "RECOVER_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
	],
	"observability": { "enabled": true },
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "secle.crimsondefense.org", "custom_domain": true }]
}
