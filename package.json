{
	"name": "sec-le",
	"private": true,
	"license": "MIT",
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.9.0",
	"scripts": {
		"data": "node scripts/build-data.ts && node --env-file-if-exists=.env.seed scripts/build-schedule.ts",
		"dev": "pnpm data && vite dev",
		"build": "pnpm data --release && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm data && CLOUDFLARE_INCLUDE_PROCESS_ENV=false wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p scripts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"gen": "CLOUDFLARE_INCLUDE_PROCESS_ENV=false wrangler types"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
